{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "octopus-predictor",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Static SPA from `vite build`; unknown paths fall back to index.html (client-side routing).
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only /api/* reaches the Worker; everything else is served straight from assets.
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // Public origin of the backend API (no trailing slash), e.g. "https://api.example.com".
    // "BACKEND_URL": "https://undelusively-unscandalized-melissia.ngrok-free.dev"
    "BACKEND_URL": "https://predictors-backend.onrender.com"
  },
  // Pings the backend every 10 minutes so Render's free tier (sleeps after 15 idle minutes)
  // never spins it down. See keepBackendAwake in worker/index.ts.
  "triggers": { "crons": ["*/10 * * * *"] },
  "observability": { "enabled": true }
}
